<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet Packaging Properties -->
    <Version>1.2.6</Version>
    <PackageReleaseNotes>v1.2.6: Kleene 3-valued logic, null-safe integer division, GroupBy/Join validity masks, ReDoS regex timeout, and dependency alignment.</PackageReleaseNotes>
    <PackageId>Glacier.Polaris</PackageId>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier</Company>
    <Description>High-performance, memory-efficient, strongly-typed pure C# .NET 10 DataFrame library built for speed, with Native AOT compatibility, SIMD vectorization, NVIDIA CUDA GPU acceleration, Glacier.Formats Compact Columnar IPC v1 / Parquet I/O, Glacier.Storage columnar encoding, and Kleene logic.</Description>
    <PackageTags>polars dataframe series dotnet csharp analytics fast high-performance columnar glacier-ipc ipc parquet aot</PackageTags>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Polaris</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Build & AOT Hygiene -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn Condition="!$(NoWarn.Contains('CS1591'))">$(NoWarn);CS1591</NoWarn>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Polaris.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj" Condition="Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Formats" Condition="!Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Storage/src/Glacier.Storage/Glacier.Storage.csproj" Condition="Exists('../../../Glacier.Storage/src/Glacier.Storage/Glacier.Storage.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Storage" Condition="!Exists('../../../Glacier.Storage/src/Glacier.Storage/Glacier.Storage.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj" Condition="Exists('../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Gpu" Condition="!Exists('../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj') or '$(UseLocalProjectReferences)' == 'false'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
